{
  "name": "control-panel",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai2human-db",
      "database_id": "d693ab30-6309-4e00-be28-7e773bee04f6"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
